# Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# MCP Server Credentials
# =============================================================================
# Fill in the credentials below, then run: npm run setup-mcp
# This will generate .vscode/mcp.json with your credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Atlassian (Jira + Confluence via Okta)
# Get API token: https://id.atlassian.com/manage-profile/security/api-tokens
# -----------------------------------------------------------------------------
ATLASSIAN_HOST=your-company.atlassian.net
ATLASSIAN_EMAIL=your-email@company.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# -----------------------------------------------------------------------------
# Slack
# Create a Slack app: https://api.slack.com/apps
# Required scopes: channels:history, channels:read, users:read, chat:write
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_TEAM_ID=T0YOUR0TEAM0ID

# -----------------------------------------------------------------------------
# Microsoft Graph (Office 365, OneDrive, Calendar)
# Register app: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Required permissions: Calendars.Read, Files.Read, Mail.Read, User.Read
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# Google Calendar (optional, if not using Microsoft)
# Create credentials: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
# GOOGLE_CALENDAR_CREDENTIALS_PATH=/path/to/google-credentials.json

# -----------------------------------------------------------------------------
# Gong
# Get API credentials: Gong Settings > API > Create API Key
# -----------------------------------------------------------------------------
GONG_API_KEY=your-gong-api-key
GONG_API_SECRET=your-gong-api-secret
# Optional: override API base URL (your region-specific Gong API host)
GONG_BASE_URL=https://us-12345.api.gong.io

# -----------------------------------------------------------------------------
# Filesystem (optional - defaults to project root)
# -----------------------------------------------------------------------------
# FILESYSTEM_ROOT_PATH=/path/to/workspace

# =============================================================================
# Advanced MCP Settings (optional)
# =============================================================================
# MCP_CONFIG_PATH=/path/to/custom/mcp-config.json
# MCP_CONNECTION_TIMEOUT=30000
# MCP_MAX_RETRIES=3
# MCP_RETRY_DELAY=2000
